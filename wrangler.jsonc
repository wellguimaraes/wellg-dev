{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wellg-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "wellg.dev", "custom_domain": true },
    { "pattern": "www.wellg.dev", "custom_domain": true }
  ]
}
